    "custom_html_6mKYkj": {
      "type": "custom-html",
      "disabled": true,
      "settings": {
        "code": "<style>\n    .video-container {\n        position: relative;\n        width: 100%;\n        max-height: 100vh;\n        overflow: hidden;\n    }\n    video {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        position: relative;\n    }\n    .unmute-button {\n        position: absolute;\n        bottom: 20px;\n        left: 20px;\n        background: rgba(0, 0, 0, 0.7);\n        color: white;\n        padding: 0.6rem 1rem;\n        border: none;\n        cursor: pointer;\n        font-size: 1rem;\n        border-radius: 5px;\n    }\n    /* Adjustments for small screens */\n    @media (max-width: 768px) {\n        .video-container {\n            max-height: 80vh;\n        }\n        .unmute-button {\n            bottom: 10px;\n            left: 10px;\n            padding: 0.5rem 0.8rem;\n            font-size: 0.9rem;\n        }\n    }\n</style>\n\n<div class=\"video-container\">\n    <a href=\"https://fleye.in/collections/bask-breathe\">\n        <video id=\"video-banner\" autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\">\n            <source src=\"https://cdn.shopify.com/videos/c/o/v/c108249673b7492e9cb45b59529bfbb6.mp4\" type=\"video/mp4\">\n            Your browser does not support the video tag.\n        </source></video>\n    </a>\n    <button class=\"unmute-button\" onclick=\"unmuteVideo()\">🔊</button>\n</div>\n\n<script>\n    function unmuteVideo() {\n        let video = document.getElementById(\"video-banner\");\n        video.muted = false;\n        video.play().catch(error => {\n            console.log(\"Autoplay with sound failed:\", error);\n        });\n    }\n</script>",
