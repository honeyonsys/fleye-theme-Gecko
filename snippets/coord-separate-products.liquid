<!-- Split the mapping into main products -->
{% assign main_products = product_mapping | split: '|' %}

<!-- Iterate through each main product -->
{% for main_product in main_products %}
  {% assign parts = main_product | split: ':' %}
  {% assign main_product_id = parts[0] | plus: 0 %} <!-- Convert to number -->
  {% assign sub_product_handles = parts[1] | split: ',' %}
  
  <!-- Check if the current product matches the main product -->
  {% if product.id == main_product_id %}
    
    <!-- Iterate through sub-products -->
    {% for sub_product_handle in sub_product_handles %}
      {% assign sub_product = all_products[sub_product_handle] %}
      
      {% if sub_product %}
        <div class="product-card">
          <a href="{{ sub_product.url }}" class="product-link"> <!-- Make image clickable -->
            <div class="product-image">
              <img src="{{ sub_product.featured_image | product_img_url: 'original' }}" alt="{{ sub_product.title }}" width="300">
            </div>
          </a>
          <div class="product-details">
            <h2 class="product-title" style="font-size:14px; font-weight: bold;">{{ sub_product.title }}</h2>
            <p class="product-price">{{ sub_product.price | money }}</p>
            <form action="/cart/add" method="post" class="product-form">
              <input type="hidden" name="id" value="{{ sub_product.variants.first.id }}">
              <button type="submit" class="add-to-cart">Add to Cart</button>
            </form>
          </div>
        </div>
      {% endif %}
    {% endfor %}
    
  {% endif %}
{% endfor %}

<!-- End Define the product mapping as an array by harish -->
